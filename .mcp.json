{
	"mcpServers": {
		"chrome-devtools": {
			"command": "npx",
			"args": [
				"-y",
				"chrome-devtools-mcp@latest",
				"--categoryExperimentalWebmcp",
				"--autoConnect",
				"--no-usage-statistics"
			]
		},
		"cap-desktop-webmcp": {
			"command": "bun",
			"args": ["webmcp-bridge/server.mjs"]
		}
	}
}
